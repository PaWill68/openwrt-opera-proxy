msgid "Expecting a URL starting with http:// or https://"
msgstr "Требуется URL, начинающийся с http:// или https://"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:108
msgid "Expecting scheme://[login:password@]host[:port], where scheme is http, https, socks5 or socks5h"
msgstr "Требуется формат схема://[логин:пароль@]хост[:порт], где схема - http, https, socks5 или socks5h"

