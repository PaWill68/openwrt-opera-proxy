msgstr "URL текстового файла с прокси-серверами-кандидатами для доступа к SurfEasy API;"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:324
msgid "Falls back to the candidates file above if download fails"
msgstr "Если загрузка не удалась, используется файл с кандидатами, указанный выше"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:326
msgid "API proxy parallel tests"
msgstr "API proxy parallel tests"
#msgstr "Параллельные проверки прокси для API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:331
msgid "Number of API proxy candidates tested in parallel when the candidates file is used (default 15)"
msgstr "Число прокси-кандидатов для API, проверяемых параллельно, когда используется файл с кандидатами (по умолчанию 15)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:335
msgid "Upstream proxy"
msgstr "Upstream proxy"
#msgstr "Вышестоящий прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:340
msgid "Sets base proxy to use for all dial-outs."
msgstr "Базовый прокси для всех исходящих подключений."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:342
msgid "Examples: http://user:password@192.168.1.1:3128, socks5://10.0.0.1:1080"
msgstr "Примеры: http://логин:пароль@192.168.1.1:3128, socks5://10.0.0.1:1080"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:344
msgid "Override proxy address"
msgstr "Override proxy address"
#msgstr "Переопределение адреса прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:348
msgid "Use fixed proxy address instead of server address returned by SurfEasy API"
msgstr "Использовать фиксированный адрес прокси вместо адреса сервера, возвращаемого SurfEasy API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:350
msgid "Proxy blacklist file"
msgstr "Proxy blacklist file"
#msgstr "Файл чёрного списка прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:354
msgid "Path to file with blacklisted proxy addresses, one host[:port] per line"
