msgid "fastest"
msgstr "быстрый"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:367
msgid "first"
msgstr "первый"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:361
