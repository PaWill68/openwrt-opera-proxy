msgid "Expecting a domain name, e.g. example.com"
msgstr "Требуется доменное имя, например example.com"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:146
msgid "Each entry must start with dns://, https://, tls:// or tcp:// and contain no spaces or commas"
msgstr "Запись должна начинаться с dns://, https://, tls:// или tcp:// и не содержать пробелов и запятых"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:153
msgid "Each pattern must not contain spaces, commas or quotes"
