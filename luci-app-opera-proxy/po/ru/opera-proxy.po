#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:356
msgid "Proxy bypass"
msgstr "Proxy bypass"
#msgstr "Исключения прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js:360
msgid "List of destination host or URL patterns that should bypass proxying and connect directly;"
