msgstr "Остановить"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Restart"
msgstr "Перезапустить"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Executing action: %s ..."
msgstr "Выполняется действие: %s ..."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Last action completed: %s"
msgstr "Последнее действие завершено: %s"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Operation failed"
msgstr "Операция не выполнена"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Testing proxy via %s %s ..."
msgstr "Проверка прокси через %s %s ..."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Empty response from test target"
msgstr "Пустой ответ от тестового сервера"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Proxy test succeeded. Exit IP: %s"
msgstr "Проверка прокси прошла успешно. Внешний IP: %s"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Proxy test failed"
msgstr "Проверка прокси не удалась"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Disabling autostart ..."
msgstr "Отключение автозапуска ..."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Enabling autostart ..."
msgstr "Включение автозапуска ..."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Autostart disabled."
msgstr "Автозапуск отключён."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Autostart enabled."
msgstr "Автозапуск включён."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Runtime state"
msgstr "Текущее состояние"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Loading status..."
msgstr "Загрузка состояния..."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Actions"
msgstr "Действия"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Start service"
msgstr "Запуск службы"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Restart service"
msgstr "Перезапуск службы"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Stop service"
msgstr "Остановка службы"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Enable service"
msgstr "Автозапуск службы"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Test proxy connection"
msgstr "Проверка соединения через прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Test proxy"
msgstr "Проверить прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "No action executed yet"
msgstr "Действия ещё не выполнялись"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Expecting a duration with a unit, e.g. 30s, 1m30s or 4h"
msgstr "Требуется длительность с единицей измерения, например 30s, 1m30s или 4h"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Expecting an integer greater than 0"
msgstr "Требуется целое число больше 0"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Expecting a URL starting with http:// or https://"
msgstr "Требуется URL, начинающийся с http:// или https://"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Expecting scheme://[login:password@]host[:port], where scheme is http, https, socks5 or socks5h"
msgstr "Требуется формат схема://[логин:пароль@]хост[:порт], где схема — http, https, socks5 или socks5h"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Expecting a domain name, e.g. example.com"
msgstr "Требуется доменное имя, например example.com"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Each entry must start with dns://, https://, tls:// or tcp:// and contain no spaces or commas"
msgstr "Каждая запись должна начинаться с dns://, https://, tls:// или tcp:// и не содержать пробелов и запятых"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Each pattern must not contain spaces, commas or quotes"
msgstr "Каждый шаблон не должен содержать пробелов, запятых и кавычек"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "General"
msgstr "Общие"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API"
msgstr "API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Proxy"
msgstr "Прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Server"
msgstr "Сервер"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "HTTP"
msgstr "HTTP"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "SOCKS5"
msgstr "SOCKS5"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Proxy server mode (default \"HTTP\")"
msgstr "Режим прокси-сервера (по умолчанию «HTTP»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Listen address"
msgstr "Адрес прослушивания"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Proxy listen address (default \"127.0.0.1:18080\")"
msgstr "Адрес, на котором прокси принимает соединения (по умолчанию «127.0.0.1:18080»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Country"
msgstr "Страна"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "EU - Europe"
msgstr "EU — Европа"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "AM - Americas"
msgstr "AM — Америка"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "AS - Asia"
msgstr "AS — Азия"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Desired proxy location (default \"EU\")"
msgstr "Желаемое расположение прокси (по умолчанию «EU»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Bootstrap DNS"
msgstr "Bootstrap DNS"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "List of DNS/DoH/DoT resolvers for initial discovery of SurfEasy API address"
msgstr "Список DNS/DoH/DoT-резолверов для первичного определения адреса SurfEasy API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Supported schemes are: dns://, https://, tls://, tcp://"
msgstr "Поддерживаемые схемы: dns://, https://, tls://, tcp://"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Examples: https://1.1.1.1/dns-query, tls://9.9.9.9:853"
msgstr "Примеры: https://1.1.1.1/dns-query, tls://9.9.9.9:853"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Leave empty to use the built-in list:"
msgstr "Оставьте пустым, чтобы использовать встроенный список:"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "CA file"
msgstr "Файл CA"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Use custom CA certificate bundle file"
msgstr "Использовать собственный файл с набором сертификатов CA"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Fake SNI"
msgstr "Поддельный SNI"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Domain name to use as SNI in outbound TLS and tunneled TLS ClientHello where possible"
msgstr "Доменное имя, которое по возможности используется как SNI во внешнем и туннелируемом TLS ClientHello"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Init retries"
msgstr "Попытки инициализации"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Number of attempts for initialization steps (0 = unlimited)"
msgstr "Число попыток для шагов инициализации (0 — без ограничений)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Init retry interval"
msgstr "Интервал между попытками инициализации"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Delay between initialization retries (default 5s)"
msgstr "Задержка между повторными попытками инициализации (по умолчанию 5s)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Discover repeat"
msgstr "Повторы обнаружения"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Number of repeated discover requests to aggregate and deduplicate (default 1)"
msgstr "Число повторных запросов обнаружения, результаты которых объединяются и очищаются от дубликатов (по умолчанию 1)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Verbosity"
msgstr "Подробность журнала"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "10 - debug"
msgstr "10 — отладка"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "20 - info"
msgstr "20 — информация"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "30 - warning"
msgstr "30 — предупреждения"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "40 - error"
msgstr "40 — ошибки"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "50 - critical"
msgstr "50 — критические"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "60 - silent (no output)"
msgstr "60 — без вывода"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Logging verbosity (default 20 - info)"
msgstr "Уровень детализации журнала (по умолчанию 20 — информация)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API address override"
msgstr "Переопределение адреса API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Override IP address of api2.sec-tunnel.com"
msgstr "Переопределяет IP-адрес api2.sec-tunnel.com"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API client type"
msgstr "Тип клиента API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Client type reported to SurfEasy API (default \"se0316\")"
msgstr "Тип клиента, сообщаемый SurfEasy API (по умолчанию «se0316»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API client version"
msgstr "Версия клиента API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Client version reported to SurfEasy API (default \"Stable 114.0.5282.21\")"
msgstr "Версия клиента, сообщаемая SurfEasy API (по умолчанию «Stable 114.0.5282.21»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API login"
msgstr "Логин API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "SurfEasy API login (default \"se0316\")"
msgstr "Логин SurfEasy API (по умолчанию «se0316»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API password"
msgstr "Пароль API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "SurfEasy API password (default \"SILrMEPBmJuhomxWkfm3JalqHX2Eheg1YhlEZiMh8II\")"
msgstr "Пароль SurfEasy API (по умолчанию «SILrMEPBmJuhomxWkfm3JalqHX2Eheg1YhlEZiMh8II»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API user agent"
msgstr "User-Agent API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "User agent reported to SurfEasy API"
msgstr "User-Agent, сообщаемый SurfEasy API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "(default \"%s\")"
msgstr "(по умолчанию «%s»)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API proxy"
msgstr "Прокси для API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Additional proxy server used to access SurfEasy API"
msgstr "Дополнительный прокси-сервер для доступа к SurfEasy API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Format: &lt;http|https|socks5|socks5h&gt;://[login:password@]host[:port]."
msgstr "Формат: &lt;http|https|socks5|socks5h&gt;://[логин:пароль@]хост[:порт]."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API proxy candidates file"
msgstr "Файл с кандидатами прокси для API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Path to text file with candidate proxy servers for SurfEasy API access, one per line;"
msgstr "Путь к текстовому файлу с прокси-серверами-кандидатами для доступа к SurfEasy API, по одному в строке;"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Proxies are tried in order until init/discover succeeds"
msgstr "Прокси перебираются по порядку, пока инициализация/обнаружение не завершится успешно"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API proxy list URL"
msgstr "URL списка прокси для API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "URL of a text file with candidate proxy servers for SurfEasy API access;"
msgstr "URL текстового файла с прокси-серверами-кандидатами для доступа к SurfEasy API;"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Falls back to the candidates file above if download fails"
msgstr "Если загрузка не удалась, используется файл с кандидатами, указанный выше"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "API proxy parallel tests"
msgstr "Параллельные проверки прокси для API"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Number of API proxy candidates tested in parallel when the candidates file is used (default 15)"
msgstr "Число прокси-кандидатов для API, проверяемых параллельно, когда используется файл с кандидатами (по умолчанию 15)"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Upstream proxy"
msgstr "Вышестоящий прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Sets base proxy to use for all dial-outs."
msgstr "Базовый прокси для всех исходящих подключений."

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Examples: http://user:password@192.168.1.1:3128, socks5://10.0.0.1:1080"
msgstr "Примеры: http://user:password@192.168.1.1:3128, socks5://10.0.0.1:1080"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
msgid "Override proxy address"
msgstr "Переопределение адреса прокси"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/settings.js
