msgid "Memory"
msgstr "Память"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Free:"
msgstr "Свободно:"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
msgid "Uptime:"
msgstr "Время работы:"

#: luci-app-opera-proxy/htdocs/luci-static/resources/view/opera-proxy/status.js
