# Конфигурация opera-proxy. Удобнее всего менять через LuCI: Службы -> Opera Proxy.
#
# Ни один параметр не обязателен: если опция не задана, init-скрипт не передаёт
# соответствующий флаг, и бинарник использует своё значение по умолчанию.
# Соответствие опций и флагов командной строки см. в /etc/init.d/opera-proxy.

config service 'main'
	option api_proxy_list_url 'https://raw.githubusercontent.com/VPSLabCloud/VPSLab-Free-Proxy-List/main/http_anonymous.txt'
